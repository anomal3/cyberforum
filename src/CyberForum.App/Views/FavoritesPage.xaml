<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberForum.App.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:storage="clr-namespace:CyberForum.Core.Storage;assembly=CyberForum.Core"
    xmlns:vm="clr-namespace:CyberForum.App.ViewModels"
    x:DataType="vm:FavoritesViewModel"
    BackgroundColor="{AppThemeBinding Light=#f2f4f7, Dark=#14171a}"
    Title="Избранное">

    <Grid RowDefinitions="Auto,*">

        <Label
            Grid.Row="0"
            Margin="16,10,16,0"
            FontSize="12"
            Opacity="0.6"
            Text="Смахни строку влево, чтобы убрать тему из избранного" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Rows}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    Margin="24"
                    HorizontalTextAlignment="Center"
                    Opacity="0.7"
                    Text="Пока пусто. Открой тему и нажми звёздочку в её шапке." />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="storage:ThreadReadState">

                    <SwipeView Margin="12,5">
                        <!-- Reveal, а не Execute: сперва показываем кнопку и ждём,
                             пока по ней ткнут — смахнул и всё пропало пугает. -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                <SwipeItemView
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=RemoveCommand}"
                                    CommandParameter="{Binding .}">

                                    <Border
                                        Margin="6,0,0,0"
                                        BackgroundColor="#b3261e"
                                        Stroke="Transparent"
                                        WidthRequest="76">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout
                                            HorizontalOptions="Center"
                                            Spacing="2"
                                            VerticalOptions="Center">

                                            <Path
                                                Data="{StaticResource IconTrash}"
                                                HorizontalOptions="Center"
                                                Style="{StaticResource IconButton}" />

                                            <Label
                                                FontSize="11"
                                                HorizontalOptions="Center"
                                                Text="убрать"
                                                TextColor="White" />
                                        </VerticalStackLayout>
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border
                            Padding="14,12"
                            BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1c2126}"
                            Stroke="{AppThemeBinding Light=#e2e5e9, Dark=#2a3037}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*">
                                <Path
                                    Grid.Column="0"
                                    Margin="0,2,10,0"
                                    Data="{StaticResource IconStar}"
                                    Fill="#e2a03f"
                                    Style="{StaticResource IconRow}"
                                    VerticalOptions="Start" />

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label
                                        FontSize="15"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Title}" />

                                    <Label
                                        FontSize="12"
                                        Opacity="0.6"
                                        Text="{Binding SeenAtUtc, Converter={StaticResource AgoConverter}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
