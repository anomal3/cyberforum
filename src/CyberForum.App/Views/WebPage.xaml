<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberForum.App.Views.WebPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <Label
            Grid.Row="0"
            Padding="16,10"
            FontSize="12"
            Opacity="0.65"
            Text="Это страница форума как есть — правки сохраняются на нём." />

        <WebView x:Name="Page" Grid.Row="1" />
    </Grid>
</ContentPage>
