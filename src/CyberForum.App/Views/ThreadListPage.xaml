<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberForum.App.Views.ThreadListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CyberForum.App.ViewModels"
    x:DataType="vm:ThreadListViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <Label
            Grid.Row="0"
            Margin="16,12"
            IsVisible="{Binding HasError}"
            Text="{Binding ErrorMessage}"
            TextColor="{AppThemeBinding Light=#b3261e, Dark=#f2b8b5}" />

        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">

            <CollectionView
                ItemsSource="{Binding Threads}"
                RemainingItemsThreshold="5"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThreadRow">
                        <Grid
                            Padding="16,12"
                            ColumnDefinitions="Auto,*"
                            Opacity="{Binding Fade}"
                            RowDefinitions="Auto,Auto,Auto">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ThreadListViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <!-- точка у тем, где с прошлого захода прибавились ответы -->
                            <BoxView
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,7,8,0"
                                CornerRadius="4"
                                HeightRequest="8"
                                IsVisible="{Binding HasFresh}"
                                VerticalOptions="Start"
                                WidthRequest="8"
                                Color="#0092ca" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="16"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding Title}" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                FontSize="14"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Opacity="0.7"
                                Text="{Binding Preview}" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,6,0,0"
                                FontSize="12"
                                Opacity="0.6">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Counter}" />
                                        <Span Text="   ·   " />
                                        <Span Text="{Binding LastPostAt, Converter={StaticResource AgoConverter}}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
