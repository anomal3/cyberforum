<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberForum.App.Views.ForumsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CyberForum.Core.Models;assembly=CyberForum.Core"
    xmlns:vm="clr-namespace:CyberForum.App.ViewModels"
    x:DataType="vm:ForumsViewModel"
    Title="Разделы">

    <Grid RowDefinitions="Auto,*">

        <Label
            Grid.Row="0"
            Margin="16,12"
            IsVisible="{Binding HasError}"
            Text="{Binding ErrorMessage}"
            TextColor="{AppThemeBinding Light=#b3261e, Dark=#f2b8b5}" />

        <RefreshView
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">

            <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ForumCategory">
                        <VerticalStackLayout>

                            <!-- Разделы категории открываются отдельной страницей: список
                                 внутри списка MAUI строит целиком, и на телефоне экран
                                 просто вставал колом. -->
                            <Grid
                                Padding="16,16"
                                BackgroundColor="Transparent"
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ForumsViewModel}}, Path=OpenCategoryCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Name}" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="{Binding Counter}" />

                                <Path
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Data="{StaticResource IconChevron}"
                                    Style="{StaticResource IconArrow}" />
                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{AppThemeBinding Light=#e2e5e9, Dark=#262c33}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
