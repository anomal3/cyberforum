<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberForum.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:models="clr-namespace:CyberForum.Core.Models;assembly=CyberForum.Core"
    xmlns:vm="clr-namespace:CyberForum.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:DataType="vm:ProfileViewModel"
    BackgroundColor="{AppThemeBinding Light=#f2f4f7, Dark=#14171a}"
    Title="Профиль">

    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,20" Spacing="0">

            <!-- кто мы -->
            <Border
                Margin="12,10"
                Padding="16,16"
                BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1c2126}"
                Stroke="{AppThemeBinding Light=#e2e5e9, Dark=#2a3037}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">

                    <!-- аватар живёт только в своей строке: с растяжкой на две
                         кнопка ниже наезжала прямо на него -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,14,0"
                        HeightRequest="52"
                        Stroke="{AppThemeBinding Light=#e2e5e9, Dark=#2a3037}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="52">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>

                        <Image Aspect="AspectFill" Source="{Binding AvatarUrl}" />
                    </Border>

                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="19"
                        Text="{Binding Status}"
                        VerticalOptions="Center" />

                    <!-- кнопка во всю ширину карточки, иконка слева от подписи -->
                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,14,0,0"
                        Command="{Binding SignInCommand}"
                        ContentLayout="Left,10"
                        HorizontalOptions="Fill"
                        ImageSource="icon_signin.png"
                        IsVisible="{Binding IsSignedIn, Converter={StaticResource NotConverter}}"
                        Text="Войти" />

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,14,0,0"
                        Command="{Binding SignOutCommand}"
                        ContentLayout="Left,10"
                        HorizontalOptions="Fill"
                        ImageSource="icon_signout.png"
                        IsVisible="{Binding IsSignedIn}"
                        Text="Выйти" />
                </Grid>
            </Border>

            <!-- ходы в списки -->
            <Border
                Margin="12,4"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1c2126}"
                Stroke="{AppThemeBinding Light=#e2e5e9, Dark=#2a3037}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout>

                    <Grid
                        Padding="16,15"
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        IsVisible="{Binding IsSignedIn}">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenMyThreadsCommand}" />
                        </Grid.GestureRecognizers>

                        <Path Grid.Column="0" Margin="0,0,12,0" Data="{StaticResource IconComment}" Style="{StaticResource IconRow}" />
                        <Label Grid.Column="1" FontSize="16" Text="Мои темы" />
                        <Path Grid.Column="3" Margin="10,0,0,0" Data="{StaticResource IconChevron}" Style="{StaticResource IconArrow}" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        IsVisible="{Binding IsSignedIn}"
                        Color="{AppThemeBinding Light=#eef0f3, Dark=#242a30}" />

                    <Grid Padding="16,15" ColumnDefinitions="Auto,*,Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenFavoritesCommand}" />
                        </Grid.GestureRecognizers>

                        <Path Grid.Column="0" Margin="0,0,12,0" Data="{StaticResource IconStar}" Fill="#e2a03f" Style="{StaticResource IconRow}" />
                        <Label Grid.Column="1" FontSize="16" Text="Избранное" />
                        <Label Grid.Column="2" FontSize="14" Opacity="0.55" Text="{Binding FavoritesCount}" />
                        <Path Grid.Column="3" Margin="10,0,0,0" Data="{StaticResource IconChevron}" Style="{StaticResource IconArrow}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#eef0f3, Dark=#242a30}" />

                    <Grid Padding="16,15" ColumnDefinitions="Auto,*,Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenHistoryCommand}" />
                        </Grid.GestureRecognizers>

                        <Path Grid.Column="0" Margin="0,0,12,0" Data="{StaticResource IconClock}" Style="{StaticResource IconRow}" />
                        <Label Grid.Column="1" FontSize="16" Text="Недавно читали" />
                        <Label Grid.Column="2" FontSize="14" Opacity="0.55" Text="{Binding HistoryCount}" />
                        <Path Grid.Column="3" Margin="10,0,0,0" Data="{StaticResource IconChevron}" Style="{StaticResource IconArrow}" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        IsVisible="{Binding IsSignedIn}"
                        Color="{AppThemeBinding Light=#eef0f3, Dark=#242a30}" />

                    <Grid
                        Padding="16,15"
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        IsVisible="{Binding IsSignedIn}">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenBestAnswersCommand}" />
                        </Grid.GestureRecognizers>

                        <Path Grid.Column="0" Margin="0,0,12,0" Data="{StaticResource IconCheck}" Style="{StaticResource IconRow}" />
                        <Label Grid.Column="1" FontSize="16" Text="Отмеченные ответы" />
                        <Label Grid.Column="2" FontSize="14" Opacity="0.55" Text="{Binding BestAnswersCount}" />
                        <Path Grid.Column="3" Margin="10,0,0,0" Data="{StaticResource IconChevron}" Style="{StaticResource IconArrow}" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        IsVisible="{Binding IsSignedIn}"
                        Color="{AppThemeBinding Light=#eef0f3, Dark=#242a30}" />

                    <Grid
                        Padding="16,15"
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        IsVisible="{Binding IsSignedIn}">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenBookmarksCommand}" />
                        </Grid.GestureRecognizers>

                        <Path Grid.Column="0" Margin="0,0,12,0" Data="{StaticResource IconBookmark}" Style="{StaticResource IconRow}" />
                        <Label Grid.Column="1" FontSize="16" Text="Закладки сообщений" />
                        <Label Grid.Column="2" FontSize="14" Opacity="0.55" Text="{Binding BookmarksCount}" />
                        <Path Grid.Column="3" Margin="10,0,0,0" Data="{StaticResource IconChevron}" Style="{StaticResource IconArrow}" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        IsVisible="{Binding IsSignedIn}"
                        Color="{AppThemeBinding Light=#eef0f3, Dark=#242a30}" />

                    <Grid
                        Padding="16,15"
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        IsVisible="{Binding IsSignedIn}">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenReputationCommand}" />
                        </Grid.GestureRecognizers>

                        <Path Grid.Column="0" Margin="0,0,12,0" Data="{StaticResource IconThumb}" Style="{StaticResource IconRow}" />
                        <Label Grid.Column="1" FontSize="16" Text="Полученные отзывы" />
                        <Label Grid.Column="2" FontSize="14" Opacity="0.55" Text="{Binding ReputationCount}" />
                        <Path Grid.Column="3" Margin="10,0,0,0" Data="{StaticResource IconChevron}" Style="{StaticResource IconArrow}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- статистика -->
            <Border
                Margin="12,8,12,4"
                Padding="16,14"
                BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1c2126}"
                IsVisible="{Binding HasStats}"
                Stroke="{AppThemeBinding Light=#e2e5e9, Dark=#2a3037}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Margin="0,0,0,6"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Статистика" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stats}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProfileField">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontSize="14"
                                    Opacity="0.6"
                                    Text="{Binding Name}" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- обо мне -->
            <Border
                Margin="12,4"
                Padding="16,14"
                BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1c2126}"
                IsVisible="{Binding HasAbout}"
                Stroke="{AppThemeBinding Light=#e2e5e9, Dark=#2a3037}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Обо мне" />

                        <Label
                            Grid.Column="1"
                            FontSize="14"
                            Text="Изменить"
                            TextColor="{AppThemeBinding Light=#0b57a6, Dark=#6ea0ff}">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditAboutCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding About}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ProfileField">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="14"
                                        Opacity="0.6"
                                        Text="{Binding Name}" />

                                    <Label
                                        Grid.Column="1"
                                        FontSize="14"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- блог -->
            <Border
                Margin="12,4"
                Padding="16,14"
                BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1c2126}"
                IsVisible="{Binding HasBlog}"
                Stroke="{AppThemeBinding Light=#e2e5e9, Dark=#2a3037}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Grid Margin="0,0,0,4" ColumnDefinitions="Auto,*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Блог" />

                        <Label
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            FontSize="14"
                            Text="все записи"
                            TextColor="{AppThemeBinding Light=#0b57a6, Dark=#6ea0ff}"
                            VerticalOptions="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenBlogListCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label
                            Grid.Column="2"
                            FontSize="14"
                            Text="Изменить"
                            TextColor="{AppThemeBinding Light=#0b57a6, Dark=#6ea0ff}">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditBlogCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Blog}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:BlogEntry">
                            <VerticalStackLayout Spacing="2">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=OpenBlogCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Label
                                    FontSize="14"
                                    Text="{Binding Title}"
                                    TextColor="{AppThemeBinding Light=#0b57a6, Dark=#6ea0ff}" />

                                <Label
                                    FontSize="12"
                                    Opacity="0.55"
                                    Text="{Binding When}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label
                Margin="16,10"
                IsVisible="{Binding HasError}"
                Text="{Binding ErrorMessage}"
                TextColor="{AppThemeBinding Light=#b3261e, Dark=#f2b8b5}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
