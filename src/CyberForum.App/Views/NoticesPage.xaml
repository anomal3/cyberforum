<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberForum.App.Views.NoticesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CyberForum.Core.Models;assembly=CyberForum.Core"
    xmlns:vm="clr-namespace:CyberForum.App.ViewModels"
    x:DataType="vm:NoticesViewModel"
    BackgroundColor="{AppThemeBinding Light=#f2f4f7, Dark=#14171a}"
    Title="Уведомления">

    <Grid RowDefinitions="Auto,*">

        <Label
            Grid.Row="0"
            Margin="16,14"
            IsVisible="{Binding HasError}"
            Opacity="0.75"
            Text="{Binding ErrorMessage}" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Notices}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Notice">
                    <Border
                        Margin="12,5"
                        Padding="14,12"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1c2126}"
                        Stroke="{AppThemeBinding Light=#e2e5e9, Dark=#2a3037}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NoticesViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                FontSize="15"
                                Text="{Binding Title}"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="1"
                                Padding="9,3"
                                BackgroundColor="#0092ca"
                                Stroke="Transparent">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding Count}"
                                    TextColor="White" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
