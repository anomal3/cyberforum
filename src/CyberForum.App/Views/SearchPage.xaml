<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberForum.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CyberForum.Core.Models;assembly=CyberForum.Core"
    xmlns:vm="clr-namespace:CyberForum.App.ViewModels"
    x:DataType="vm:SearchViewModel"
    Title="Поиск">

    <Grid RowDefinitions="Auto,Auto,*">

        <SearchBar
            Grid.Row="0"
            Margin="8,4"
            Placeholder="Что ищем на форуме"
            SearchCommand="{Binding FindCommand}"
            Text="{Binding Query}" />

        <Label
            Grid.Row="1"
            Margin="16,4"
            IsVisible="{Binding HasError}"
            Text="{Binding ErrorMessage}"
            TextColor="{AppThemeBinding Light=#b3261e, Dark=#f2b8b5}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Results}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label
                    Margin="24"
                    HorizontalTextAlignment="Center"
                    Opacity="0.7"
                    Text="Введи запрос и нажми поиск" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ThreadSummary">
                    <Grid Padding="16,12" RowDefinitions="Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Label
                            Grid.Row="0"
                            FontSize="16"
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Text="{Binding Title}" />

                        <Label
                            Grid.Row="1"
                            FontSize="12"
                            Opacity="0.6"
                            Text="{Binding ForumSlug}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.Row="2"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
