<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CyberForum.App.Views.BlogEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CyberForum.App.Controls"
    xmlns:vm="clr-namespace:CyberForum.App.ViewModels"
    x:DataType="vm:BlogEntryViewModel"
    HideSoftInputOnTapped="True"
    Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <!-- своя запись — можно переписать прямо здесь; чужую форум просто не даст -->
        <ToolbarItem Clicked="OnEditClicked" Text="Изменить" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <Label
            Grid.Row="0"
            Margin="16,12"
            IsVisible="{Binding HasError}"
            Text="{Binding ErrorMessage}"
            TextColor="{AppThemeBinding Light=#b3261e, Dark=#f2b8b5}" />

        <WebView
            Grid.Row="1"
            Navigating="OnNavigating"
            Source="{Binding Document}" />

        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />

        <!-- полоска комментария — как полоска ответа в теме -->
        <Border
            x:Name="CommentBar"
            Grid.Row="1"
            Padding="14,10"
            BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1c2126}"
            IsVisible="False"
            Stroke="{AppThemeBinding Light=#e2e5e9, Dark=#2a3037}"
            StrokeThickness="1"
            VerticalOptions="End">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18,18,0,0" />
            </Border.StrokeShape>

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCommentBarTapped" />
            </Border.GestureRecognizers>

            <HorizontalStackLayout Spacing="10">
                <Path Data="{StaticResource IconComment}" Style="{StaticResource IconRow}" />

                <Label
                    FontSize="15"
                    Opacity="0.65"
                    Text="Написать комментарий"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <controls:ReplySheet
            x:Name="Sheet"
            Grid.Row="0"
            Grid.RowSpan="2"
            Closed="OnSheetClosed"
            FullEditor="OnFullEditorClicked"
            Send="OnSendClicked" />
    </Grid>
</ContentPage>
