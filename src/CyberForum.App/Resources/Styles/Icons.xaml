<!--
    Свой набор значков. Раньше в карточках стояли эмодзи, но они рисуются шрифтом
    системы: на одном телефоне цветные, на другом плоские, размер каждый раз свой.
    Здесь всё нарисовано одним контуром и красится темой, как остальной интерфейс.
    Сетка у всех одна — 24 на 24, поэтому значки одинаково ровно встают в строку.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- просмотры -->
    <PathGeometry
        x:Key="IconEye"
        Figures="M 12 5 C 7 5 2.7 8.1 1 12 C 2.7 15.9 7 19 12 19 C 17 19 21.3 15.9 23 12 C 21.3 8.1 17 5 12 5 Z M 12 16.5 C 9.5 16.5 7.5 14.5 7.5 12 C 7.5 9.5 9.5 7.5 12 7.5 C 14.5 7.5 16.5 9.5 16.5 12 C 16.5 14.5 14.5 16.5 12 16.5 Z M 12 9.5 C 10.6 9.5 9.5 10.6 9.5 12 C 9.5 13.4 10.6 14.5 12 14.5 C 13.4 14.5 14.5 13.4 14.5 12 C 14.5 10.6 13.4 9.5 12 9.5 Z" />

    <!-- ответы в теме -->
    <PathGeometry
        x:Key="IconComment"
        Figures="M 20 3 L 4 3 C 2.9 3 2 3.9 2 5 L 2 15 C 2 16.1 2.9 17 4 17 L 7 17 L 7 21 L 12 17 L 20 17 C 21.1 17 22 16.1 22 15 L 22 5 C 22 3.9 21.1 3 20 3 Z" />

    <!-- автор темы -->
    <PathGeometry
        x:Key="IconUser"
        Figures="M 12 12 C 14.5 12 16.5 10 16.5 7.5 C 16.5 5 14.5 3 12 3 C 9.5 3 7.5 5 7.5 7.5 C 7.5 10 9.5 12 12 12 Z M 12 14 C 7.6 14 4 16.5 4 19.5 L 4 21 L 20 21 L 20 19.5 C 20 16.5 16.4 14 12 14 Z" />

    <!-- убрать из избранного -->
    <PathGeometry
        x:Key="IconTrash"
        Figures="M 9 3 L 8 4 L 4 4 L 4 6 L 20 6 L 20 4 L 16 4 L 15 3 Z M 6 7 L 6 20 C 6 21.1 6.9 22 8 22 L 16 22 C 17.1 22 18 21.1 18 20 L 18 7 Z M 9.5 9.5 L 11 9.5 L 11 19 L 9.5 19 Z M 13 9.5 L 14.5 9.5 L 14.5 19 L 13 19 Z" />

    <!-- избранное -->
    <PathGeometry
        x:Key="IconStar"
        Figures="M 12 2.5 L 15 9 L 22 9.8 L 16.8 14.5 L 18.3 21.5 L 12 18 L 5.7 21.5 L 7.2 14.5 L 2 9.8 L 9 9 Z" />

    <!-- недавно читали -->
    <PathGeometry
        x:Key="IconClock"
        Figures="M 12 2 C 6.5 2 2 6.5 2 12 C 2 17.5 6.5 22 12 22 C 17.5 22 22 17.5 22 12 C 22 6.5 17.5 2 12 2 Z M 12 20 C 7.6 20 4 16.4 4 12 C 4 7.6 7.6 4 12 4 C 16.4 4 20 7.6 20 12 C 20 16.4 16.4 20 12 20 Z M 11 6.5 L 11 12.5 L 16 15.5 L 17 13.9 L 13 11.5 L 13 6.5 Z" />

    <!-- лучший ответ -->
    <PathGeometry
        x:Key="IconCheck"
        Figures="M 12 2 C 6.5 2 2 6.5 2 12 C 2 17.5 6.5 22 12 22 C 17.5 22 22 17.5 22 12 C 22 6.5 17.5 2 12 2 Z M 10.4 16.8 L 6 12.4 L 7.6 10.9 L 10.4 13.7 L 16.4 7.7 L 18 9.2 Z" />

    <!-- закладки сообщений -->
    <PathGeometry
        x:Key="IconBookmark"
        Figures="M 7 3 C 5.9 3 5 3.9 5 5 L 5 21.5 L 12 17.5 L 19 21.5 L 19 5 C 19 3.9 18.1 3 17 3 Z" />

    <!-- отзывы и спасибо -->
    <PathGeometry
        x:Key="IconThumb"
        Figures="M 2 21 L 6 21 L 6 10 L 2 10 Z M 22 11.5 C 22 10.4 21.1 9.5 20 9.5 L 14 9.5 L 15 5 C 15.2 4.1 14.6 3.2 13.7 3 C 13.1 2.9 12.5 3.1 12.1 3.6 L 8 9 L 8 21 L 18.5 21 C 19.4 21 20.2 20.4 20.4 19.5 L 22 12.5 Z" />

    <!-- ответить -->
    <PathGeometry
        x:Key="IconReply"
        Figures="M 10 8 L 10 4 L 2.5 11 L 10 18 L 10 13.8 C 15 13.8 18.6 15.4 21 19 C 20 14 17 9 10 8 Z" />

    <!-- ответить с цитатой -->
    <PathGeometry
        x:Key="IconQuote"
        Figures="M 5 17 L 9 17 L 11.5 12 L 11.5 5 L 4.5 5 L 4.5 12 L 7.5 12 Z M 15 17 L 19 17 L 21.5 12 L 21.5 5 L 14.5 5 L 14.5 12 L 17.5 12 Z" />

    <!-- вложение -->
    <PathGeometry
        x:Key="IconAttach"
        Figures="M 16.5 6 L 16.5 17 C 16.5 19.5 14.5 21.5 12 21.5 C 9.5 21.5 7.5 19.5 7.5 17 L 7.5 5.5 C 7.5 3.9 8.9 2.5 10.5 2.5 C 12.1 2.5 13.5 3.9 13.5 5.5 L 13.5 16 C 13.5 16.9 12.9 17.5 12 17.5 C 11.1 17.5 10.5 16.9 10.5 16 L 10.5 6 L 9 6 L 9 16 C 9 17.7 10.3 19 12 19 C 13.7 19 15 17.7 15 16 L 15 5.5 C 15 3.1 13 1 10.5 1 C 8 1 6 3.1 6 5.5 L 6 17 C 6 20.3 8.7 23 12 23 C 15.3 23 18 20.3 18 17 L 18 6 Z" />

    <!-- блок кода -->
    <PathGeometry
        x:Key="IconCode"
        Figures="M 9.4 16.6 L 4.8 12 L 9.4 7.4 L 8 6 L 2 12 L 8 18 Z M 14.6 16.6 L 19.2 12 L 14.6 7.4 L 16 6 L 22 12 L 16 18 Z" />

    <!-- картинка -->
    <PathGeometry
        x:Key="IconImage"
        Figures="M 21 3 L 3 3 C 2 3 1.5 3.9 1.5 5 L 1.5 19 C 1.5 20.1 2 21 3 21 L 21 21 C 22 21 22.5 20.1 22.5 19 L 22.5 5 C 22.5 3.9 22 3 21 3 Z M 20.5 19 L 3.5 19 L 8 13 L 11 16.5 L 15 11 Z M 8.5 10 C 7.4 10 6.5 9.1 6.5 8 C 6.5 6.9 7.4 6 8.5 6 C 9.6 6 10.5 6.9 10.5 8 C 10.5 9.1 9.6 10 8.5 10 Z" />

    <!-- отправить -->
    <PathGeometry
        x:Key="IconSend"
        Figures="M 2.5 21 L 22 12 L 2.5 3 L 2.5 10 L 16.5 12 L 2.5 14 Z" />

    <!-- закрыть -->
    <PathGeometry
        x:Key="IconClose"
        Figures="M 18.3 7.1 L 16.9 5.7 L 12 10.6 L 7.1 5.7 L 5.7 7.1 L 10.6 12 L 5.7 16.9 L 7.1 18.3 L 12 13.4 L 16.9 18.3 L 18.3 16.9 L 13.4 12 Z" />

    <!-- вглубь -->
    <PathGeometry
        x:Key="IconChevron"
        Figures="M 9 5.5 L 7.6 7 L 12.6 12 L 7.6 17 L 9 18.5 L 15.5 12 Z" />

    <!-- уведомления -->
    <PathGeometry
        x:Key="IconBell"
        Figures="M 12 22 C 13.1 22 14 21.1 14 20 L 10 20 C 10 21.1 10.9 22 12 22 Z M 18.5 16 L 18.5 10.5 C 18.5 7.2 16.7 4.5 13.7 3.8 L 13.7 3 C 13.7 2.1 12.9 1.4 12 1.4 C 11.1 1.4 10.3 2.1 10.3 3 L 10.3 3.8 C 7.3 4.5 5.5 7.2 5.5 10.5 L 5.5 16 L 3.5 18 L 3.5 19 L 20.5 19 L 20.5 18 Z" />

    <!-- значок в строке карточки: мелкий и приглушённый -->
    <Style x:Key="IconMark" TargetType="Path">
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="WidthRequest" Value="13" />
        <Setter Property="HeightRequest" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Fill" Value="{AppThemeBinding Light=#5f6b76, Dark=#9aa4ae}" />
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <!-- значок в строке-переходе: покрупнее и в цвете строки -->
    <Style x:Key="IconRow" TargetType="Path">
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="WidthRequest" Value="20" />
        <Setter Property="HeightRequest" Value="20" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Fill" Value="{AppThemeBinding Light=#4a5560, Dark=#aab4be}" />
    </Style>

    <Style x:Key="IconArrow" TargetType="Path" BasedOn="{StaticResource IconRow}">
        <Setter Property="WidthRequest" Value="16" />
        <Setter Property="HeightRequest" Value="16" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- кнопка панели редактора: не кричит, но по ней видно, что это кнопка -->
    <Style x:Key="ToolChip" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#f1f3f5, Dark=#252b32}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#3c4650, Dark=#c7ced6}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- значок на кнопке: крупный и белый -->
    <Style x:Key="IconButton" TargetType="Path">
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="WidthRequest" Value="20" />
        <Setter Property="HeightRequest" Value="20" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Fill" Value="#ffffff" />
    </Style>
</ResourceDictionary>
